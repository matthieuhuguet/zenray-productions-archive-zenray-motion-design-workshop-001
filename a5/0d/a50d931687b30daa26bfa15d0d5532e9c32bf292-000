float dither_bayer_ramp_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec4 dither_bayer_ramp(vec2 uv, float angle, vec3 c0, vec3 c1, float levels, float cells, float aspect) {
