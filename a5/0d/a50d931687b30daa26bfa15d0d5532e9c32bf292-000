  uvec2 b = uvec2(cell) & 7u;
  uint x = b.x, y = b.y;
  uint idx = 16u * (2u * ((x ^ y) & 1u) + (y & 1u)) + 4u * (2u * (((x ^ y) >> 1u) & 1u) + ((y >> 1u) & 1u))
           + (2u * (((x ^ y) >> 2u) & 1u) + ((y >> 2u) & 1u));
  float th = (float(idx) + 0.5) / 64.0;
  float L = max(floor(levels), 2.0);
  float qv = clamp(floor(t * (L - 1.0) + th) / (L - 1.0), 0.0, 1.0);
