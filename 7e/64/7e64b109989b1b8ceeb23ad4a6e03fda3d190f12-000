.sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--line); vertical-align: -2px; }
svg.ease { width: 34px; height: 18px; flex: none; }
svg.ease path { fill: none; stroke: currentColor; stroke-width: 1.6; }
.phases { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 2px; margin-top: 8px; }
.phases figure { margin: 0; min-width: 0; }
