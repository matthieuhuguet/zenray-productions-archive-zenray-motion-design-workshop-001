// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 grain_film_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
// 12 October 2026: two uniform values in [0, 1) per integer cell, exact 24-bit conversion (identical in numpy).
vec2 grain_film_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = grain_film_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
vec4 grain_film(vec2 uv, vec3 base, float amount, float density, float frame, float chroma, float response, float seed, float aspect) {
  vec2 cell = floor(vec2(uv.x * aspect, uv.y) * density + 0.000731);
  float s0 = floor(seed) + floor(frame) * 8.0;
  vec3 g;
  for (int c = 0; c < 3; c++) {
    vec2 h0 = grain_film_hash2(cell, s0 + float(2 * c));
    vec2 h1 = grain_film_hash2(cell, s0 + float(2 * c + 1));
    g[c] = (h0.x + h0.y + h1.x + h1.y - 2.0) * 1.7320508;
  }
  g = mix(vec3(g.r), g, chroma);
  float L = dot(base, vec3(0.2126, 0.7152, 0.0722));
  float w = mix(1.0, 4.0 * L * (1.0 - L), response);
  return vec4(clamp(base + amount * w * g, 0.0, 1.0), 1.0);
}
