      "composition": { "workshopPath": "motions/zrmd-0001/V_008", "assetsCloudFolder": "pages/ZenRayAssets/zenray-motion-design/sources/tmp/workshop/motions/zrmd-0001/V_008", "hyperframes": "0.8.147", "gsap": "3.14.2" },
      "renders": [{ "aspect": "16x9", "media": "pages/ZenRayMotionDesign/zrmd-0001/versions/zrmd-0001-v008-16x9.media.json", "poster": "<URL jsDelivr épinglée>", "durationSec": 68.05, "bytes": 13863214, "sha256": "<empreinte du MP4>" }],
