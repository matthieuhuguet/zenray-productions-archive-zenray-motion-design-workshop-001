import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def render(params, u, v):
    q = params
    cx = np.floor(u * q['aspect'] * q['density'] + 0.000731)
    cy = np.floor(v * q['density'] + 0.000731)
    s0 = np.floor(q['seed']) + np.floor(q['frame']) * 8.0
    g = []
    for c in range(3):
        h0 = _hash2(cx, cy, s0 + 2 * c)
        h1 = _hash2(cx, cy, s0 + 2 * c + 1)
        g.append((h0[0] + h0[1] + h1[0] + h1[1] - 2.0) * 1.7320508)
    g = np.stack(g, axis=-1)
    g = g[..., :1] + (g - g[..., :1]) * q['chroma']
    base = _v(q['base'])
    L = float(base @ LUMA)
    w = 1.0 + (4.0 * L * (1.0 - L) - 1.0) * q['response']
    return np.clip(base + q['amount'] * w * g, 0.0, 1.0) * 255.0
