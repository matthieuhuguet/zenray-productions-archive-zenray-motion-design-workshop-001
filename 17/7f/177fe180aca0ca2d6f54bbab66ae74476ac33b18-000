def ink_width(text, font, tracking=0.0):
    img = Image.new("L", (4000, 300), 0)
    draw_tracked(ImageDraw.Draw(img), (20, 50), text, font, 255, tracking)
    box = img.getbbox()
    return box[2] - box[0], box[3] - box[1]


def draw_tracked(draw, origin, text, font, fill, tracking):
    x0, y0 = origin
    for k, ch in enumerate(text):
        draw.text((x0 + font.getlength(text[:k]) + k * tracking, y0), ch, font=font, fill=fill)


def fit_words(target_text, words, font, joiner=" ", count=2, needs=None):
    """Original words whose ink box matches the reference; a sub-pixel tracking closes the remaining gap."""
    target_w, target_h = ink_width(target_text, font)
    best = None
    for combo in itertools.permutations(words, count):
        text = joiner.join(combo)
        if needs and not needs(text):
            continue
        w, h = ink_width(text, font)
        score = abs(w - target_w) + 5 * abs(h - target_h)
        if best is None or score < best[0]:
            best = (score, text, w, h)
    _, text, w, h = best
    gaps = max(len(text) - 1, 1)
    tracking = (target_w - w) / gaps
    return text, tracking, (w, h), (target_w, target_h)


def lerp(a, b, u):
    return tuple(a[i] + (b[i] - a[i]) * u for i in range(3))


def logo_mask(kind, cx, cy, scale):
    m = Image.new("L", (W * scale, H * scale), 0)
    d = ImageDraw.Draw(m)
    s = scale
    if kind == "ring":
        d.ellipse([(cx - 30) * s, (cy - 30) * s, (cx + 30) * s, (cy + 30) * s], fill=255)
        d.ellipse([(cx - 17) * s, (cy - 17) * s, (cx + 17) * s, (cy + 17) * s], fill=0)
        d.rectangle([(cx + 38) * s, (cy - 30) * s, (cx + 50) * s, (cy + 30) * s], fill=255)
    else:  # original mark: three bars, same box (80 x 60) and same ink area as the ring mark
        area = math.pi * (30 ** 2 - 17 ** 2) + 12 * 60
        bw = area / (60 + 44 + 60)
        left = cx - 30
        for i, h in enumerate((60, 44, 60)):
            x = left + i * (80 - bw) / 2
            d.rectangle([x * s, (cy + 30 - h) * s, (x + bw) * s, (cy + 30) * s], fill=255)
    return m


def render_frame(args):
    p, index = args
    t = index / FPS
    S = SS
    # background gradient
    rows = np.linspace(0, 1, H * S)[:, None, None]
    img = np.asarray(BG_TOP, dtype=np.float64)[None, None, :] * (1 - rows) + np.asarray(BG_BOTTOM, dtype=np.float64) * rows
    img = np.repeat(img, W * S, axis=1)
    # accent disc with glow, scale with back.out
    k = float(0.6 + 0.4 * LIB.evaluate("back.out(1.70158)", (t - 0.1) / 0.5))
    disc = Image.new("L", (W * S, H * S), 0)
    r = 70 * k
    ImageDraw.Draw(disc).ellipse([(980 - r) * S, (300 - r) * S, (980 + r) * S, (300 + r) * S], fill=255)
    halo = np.asarray(disc.filter(ImageFilter.GaussianBlur(p["glow_sigma"] * S)), dtype=np.float64) / 255.0
    core = np.asarray(disc, dtype=np.float64) / 255.0
    accent = np.asarray(p["accent"], dtype=np.float64)
    a_halo = 0.6 * halo[..., None]
    img = img * (1 - a_halo) + accent * a_halo
    img = img * (1 - core[..., None]) + accent * core[..., None]
    # headline: slides up 40 px and fades in
    u = (t - 0.25 - p["head_delay"]) / 0.6
    dy = 40 * (1 - float(LIB.evaluate(p["head_ease"], u)))
    alpha = float(LIB.evaluate("power1.out", (t - 0.25 - p["head_delay"]) / 0.4))
    text_layer = Image.new("L", (W * S, H * S), 0)
    font = ImageFont.truetype(FONT_BOLD, p["head_size"] * S)
    draw_tracked(ImageDraw.Draw(text_layer), (p["head_x"] * S, (p["head_y"] + dy) * S), p["head"], font, 255,
                 p["tracking_head"] * S)
    m = np.asarray(text_layer, dtype=np.float64)[..., None] / 255.0 * alpha
    img = img * (1 - m) + np.asarray(TEXT, dtype=np.float64) * m
    # subtitle and logo fade in
    a2 = float(LIB.evaluate("power1.out", (t - 0.45) / 0.4))
    sub_layer = Image.new("L", (W * S, H * S), 0)
    fsub = ImageFont.truetype(FONT_REG, 26 * S)
    draw_tracked(ImageDraw.Draw(sub_layer), (122 * S, 480 * S), p["sub"], fsub, 255, p["tracking_sub"] * S)
    m = np.asarray(sub_layer, dtype=np.float64)[..., None] / 255.0 * a2
    img = img * (1 - m) + np.asarray(SUB, dtype=np.float64) * m
    lm = np.asarray(logo_mask(p["logo"], 150, 610, S), dtype=np.float64)[..., None] / 255.0 * a2
    img = img * (1 - lm) + np.asarray(LOGO, dtype=np.float64) * lm
    # camera push-in around the centre, power1.inOut over the clip
    zoom = 1.0 + 0.04 * float(LIB.evaluate("power1.inOut", t / (FRAMES / FPS)))
    big = np.clip(img, 0, 255).astype(np.float32)
    M = np.float32([[zoom, 0, (1 - zoom) * W * S / 2], [0, zoom, (1 - zoom) * H * S / 2]])
    big = cv2.warpAffine(big, M, (W * S, H * S), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
    small = cv2.resize(big, (W, H), interpolation=cv2.INTER_AREA)
    return np.clip(np.round(small), 0, 255).astype(np.uint8)


def render(p):
    with ProcessPoolExecutor(max_workers=16) as pool:
        return np.stack(list(pool.map(render_frame, [(p, i) for i in range(FRAMES)], chunksize=3)))


def encode_decode(frames, crf=23):
    path = os.path.join(HERE, "results", "fidelity-ref-x264.mp4")
    enc = subprocess.Popen(["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{W}x{H}",
                            "-r", str(FPS), "-i", "-", "-c:v", "libx264", "-crf", str(crf), "-pix_fmt", "yuv420p", path],
                           stdin=subprocess.PIPE)
    enc.stdin.write(frames.tobytes())
    enc.stdin.close()
    enc.wait()
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", path, "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
                         capture_output=True, check=True).stdout
    return np.frombuffer(raw, dtype=np.uint8).reshape(frames.shape)


# ---------- measurement (pixels only) ----------

def srgb_to_lab(rgb):
    c = np.asarray(rgb, dtype=np.float64) / 255.0
    lin = np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
    M = np.array([[0.4124564, 0.3575761, 0.1804375], [0.2126729, 0.7151522, 0.0721750], [0.0193339, 0.1191920, 0.9503041]])
    xyz = lin @ M.T / np.array([0.95047, 1.0, 1.08883])
    f = np.where(xyz > 216 / 24389, np.cbrt(xyz), (24389 / 27 * xyz + 16) / 116)
    return np.stack([116 * f[..., 1] - 16, 500 * (f[..., 0] - f[..., 1]), 200 * (f[..., 1] - f[..., 2])], axis=-1)


def ciede2000(lab1, lab2):
    """CIEDE2000 (Sharma, Wu, Dalal 2005), kL = kC = kH = 1."""
    L1, a1, b1 = lab1
    L2, a2, b2 = lab2
    C1, C2 = math.hypot(a1, b1), math.hypot(a2, b2)
    Cb = (C1 + C2) / 2
    G = 0.5 * (1 - math.sqrt(Cb ** 7 / (Cb ** 7 + 25 ** 7)))
    a1p, a2p = (1 + G) * a1, (1 + G) * a2
    C1p, C2p = math.hypot(a1p, b1), math.hypot(a2p, b2)
    h1p = math.degrees(math.atan2(b1, a1p)) % 360
    h2p = math.degrees(math.atan2(b2, a2p)) % 360
    dLp, dCp = L2 - L1, C2p - C1p
    if C1p * C2p == 0:
        dhp = 0.0
    elif abs(h2p - h1p) <= 180:
        dhp = h2p - h1p
    elif h2p - h1p > 180:
        dhp = h2p - h1p - 360
    else:
        dhp = h2p - h1p + 360
    dHp = 2 * math.sqrt(C1p * C2p) * math.sin(math.radians(dhp / 2))
    Lbp, Cbp = (L1 + L2) / 2, (C1p + C2p) / 2
    if C1p * C2p == 0:
        hbp = h1p + h2p
    elif abs(h1p - h2p) <= 180:
        hbp = (h1p + h2p) / 2
    elif h1p + h2p < 360:
        hbp = (h1p + h2p + 360) / 2
    else:
        hbp = (h1p + h2p - 360) / 2
    T = (1 - 0.17 * math.cos(math.radians(hbp - 30)) + 0.24 * math.cos(math.radians(2 * hbp))
         + 0.32 * math.cos(math.radians(3 * hbp + 6)) - 0.20 * math.cos(math.radians(4 * hbp - 63)))
    dtheta = 30 * math.exp(-((hbp - 275) / 25) ** 2)
    Rc = 2 * math.sqrt(Cbp ** 7 / (Cbp ** 7 + 25 ** 7))
    Sl = 1 + 0.015 * (Lbp - 50) ** 2 / math.sqrt(20 + (Lbp - 50) ** 2)
    Sc, Sh = 1 + 0.045 * Cbp, 1 + 0.015 * Cbp * T
    Rt = -math.sin(math.radians(2 * dtheta)) * Rc
    return math.sqrt((dLp / Sl) ** 2 + (dCp / Sc) ** 2 + (dHp / Sh) ** 2 + Rt * (dCp / Sc) * (dHp / Sh))


def luma(frame):
    f = frame.astype(np.float64)
    return 0.2126 * f[..., 0] + 0.7152 * f[..., 1] + 0.0722 * f[..., 2]


def background_rows(frame):
    strip = luma(frame)[:, 1200:1270]
    return np.median(strip, axis=1)[:, None]


def ink_box(frame, window, fill_luma):
    x0, y0, x1, y1 = window
    y = luma(frame)
    bg = background_rows(frame)
    ink = np.clip((y - bg) / (fill_luma - bg), 0, 1)[y0:y1, x0:x1]
    mask = ink > 0.5
    if mask.sum() < 20:
        return None, ink
    ys, xs = np.nonzero(mask)
    return (x0 + xs.min(), y0 + ys.min(), x0 + xs.max() + 1, y0 + ys.max() + 1), ink


def line_metrics(ink, window):
    """Left, right, cap top (median of glyph tops) and baseline (median of glyph bottoms): robust to overshoots."""
    mask = (ink > 0.5).astype(np.uint8)
    n, _, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
    comps = [s for s in stats[1:] if s[4] >= 12]
    if not comps:
        return None
    x0, y0 = window[0], window[1]
    left = min(s[0] for s in comps) + x0
    right = max(s[0] + s[2] for s in comps) + x0
    top = float(np.median([s[1] for s in comps])) + y0
    base = float(np.median([s[1] + s[3] for s in comps])) + y0
    return (left, top, right, base)


def stroke_width(ink):
    mask = (ink > 0.5).astype(np.uint8)
    if mask.sum() < 20:
        return None
    dist = cv2.distanceTransform(mask, cv2.DIST_L2, 5)
    ridge = dist[(dist >= cv2.dilate(dist, np.ones((3, 3), np.uint8))) & (mask > 0)]
    return float(2 * np.median(ridge))


def accent_disc(frame):
    hsv = cv2.cvtColor(frame, cv2.COLOR_RGB2HSV).astype(np.float64)
    core = (hsv[..., 1] > 150) & (hsv[..., 2] > 180)
    if core.sum() < 30:
        return None
    ys, xs = np.nonzero(core)
    return float(xs.mean()), float(ys.mean()), float(math.sqrt(core.sum() / math.pi)), core


def glow_width(frame, disc):
    cx, cy, r, _ = disc
    y = luma(frame)
    bg = background_rows(frame)
    yy, xx = np.mgrid[0:H, 0:W]
    rr = np.hypot(xx - cx, yy - cy)
    prof = []
    for d in range(4, 90, 2):
        ring = (rr >= r + d) & (rr < r + d + 2) & (xx > cx - 10)  # right half: away from the text
        prof.append(float(np.mean((y - bg)[ring])))
    prof = np.array(prof)
    level = 0.25 * prof[0]
    below = np.nonzero(prof < level)[0]
    if not len(below) or below[0] == 0:
        return float("nan")
    i = below[0]
    frac = (prof[i - 1] - level) / max(prof[i - 1] - prof[i], 1e-9)  # linear interpolation between ring samples
    return float(4 + 2 * (i - 1 + frac))


WINDOWS = {"head": (80, 300, 900, 468), "sub": (80, 470, 900, 530), "logo": (90, 555, 240, 665)}
FILL = {"head": 0.2126 * TEXT[0] + 0.7152 * TEXT[1] + 0.0722 * TEXT[2],
        "sub": 0.2126 * SUB[0] + 0.7152 * SUB[1] + 0.0722 * SUB[2],
        "logo": 0.2126 * LOGO[0] + 0.7152 * LOGO[1] + 0.0722 * LOGO[2]}


def measure(frames):
    out = {"head_cy": [], "head_cov": [], "disc_r": [], "disc_cx": []}
    for frame in frames:
        box, ink = ink_box(frame, WINDOWS["head"], FILL["head"])
        out["head_cy"].append(None if box is None else (box[1] + box[3]) / 2)
        out["head_cov"].append(float(ink.sum()))
        disc = accent_disc(frame)
        out["disc_r"].append(None if disc is None else disc[2])
        out["disc_cx"].append(None if disc is None else disc[0])
    last = frames[-1]
    boxes = {}
    inks = {}
    for name in ("head", "sub", "logo"):
        boxes[name], inks[name] = ink_box(last, WINDOWS[name], FILL[name])
    disc = accent_disc(last)
    boxes["disc"] = (disc[0] - disc[2], disc[1] - disc[2], disc[0] + disc[2], disc[1] + disc[2])
    out["boxes"] = boxes
    hl = line_metrics(inks["head"], WINDOWS["head"])
    sl = line_metrics(inks["sub"], WINDOWS["sub"])
    out["layout"] = {"head": list(hl), "sub": [sl[0], sl[2], sl[3]], "logo": list(boxes["logo"]),
                     "disc": [disc[0], disc[1], disc[2]]}
    hb = boxes["head"]
    out["cap_height"] = hl[3] - hl[1]
    out["stroke"] = stroke_width(inks["head"])
    out["ink_density"] = float((inks["head"] > 0.5).sum() / ((hb[2] - hb[0]) * (hb[3] - hb[1])))
    out["glow"] = glow_width(last, disc)
    lab = {}
    lab["bg_top"] = srgb_to_lab(last[5:40, 1200:1270].reshape(-1, 3).mean(axis=0))
    lab["bg_bottom"] = srgb_to_lab(last[680:715, 1200:1270].reshape(-1, 3).mean(axis=0))
    x0, y0, x1, y1 = WINDOWS["head"]
    sel = inks["head"] > 0.95
    lab["text"] = srgb_to_lab(last[y0:y1, x0:x1][sel].mean(axis=0))
    lab["accent"] = srgb_to_lab(last[disc[3]].mean(axis=0))
    x0, y0, x1, y1 = WINDOWS["logo"]
    sel = inks["logo"] > 0.95
    lab["logo"] = srgb_to_lab(last[y0:y1, x0:x1][sel].mean(axis=0))
    out["lab"] = lab
    return out


def ssim_map(a, b):
    a, b = a.astype(np.float64), b.astype(np.float64)
    C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2
    blur = lambda x: cv2.GaussianBlur(x, (11, 11), 1.5)
    ma, mb = blur(a), blur(b)
    va, vb, cov = blur(a * a) - ma * ma, blur(b * b) - mb * mb, blur(a * b) - ma * mb
    return ((2 * ma * mb + C1) * (2 * cov + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))


def image_scores(ref, var, mref, mvar):
    full, corr, masked, low = [], [], [], {4: [], 8: [], 16: [], 24: []}
    mask = np.ones((H, W), bool)
    for m in (mref, mvar):
        for name in ("head", "sub", "logo"):
            box = m["boxes"][name]
            if box is not None:
                x0, y0, x1, y1 = box
                mask[max(0, y0 - 8):y1 + 48, max(0, x0 - 8):x1 + 8] = False  # 48 px below: the headline rises from 40 px lower
    for fa, fb in zip(ref, var):
        ya, yb = luma(fa), luma(fb)
        smap = ssim_map(ya, yb)
        full.append(smap.mean())
        masked.append(smap[mask].mean())
        corr.append(np.corrcoef(ya.ravel(), yb.ravel())[0, 1])
        for s in low:
            low[s].append(ssim_map(cv2.GaussianBlur(ya, (0, 0), s), cv2.GaussianBlur(yb, (0, 0), s)).mean())
    return {"ssim_full": float(np.mean(full)), "pixel_corr": float(np.mean(corr)), "ssim_masked": float(np.mean(masked)),
            "masked_fraction": float(1 - mask.mean()),
            **{f"ssim_lowpass_sigma{s}": float(np.mean(v)) for s, v in low.items()}}


def series_rms(a, b):
    pairs = [(x, y) for x, y in zip(a, b) if x is not None and y is not None]
    if not pairs:
        return float("inf")
    return math.sqrt(sum((x - y) ** 2 for x, y in pairs) / len(pairs))


UNITS = {"position_px1080": 1.0, "ratio": 0.01, "delta_e00": 1.0, "glow_ratio": 0.05}


def score(errors_in_jnd):
    """Dimension score: 1 - 0.01 * mean(squared JND errors); 0.99 means an RMS error of one JND."""
    if not errors_in_jnd:
        return 1.0
    return max(0.0, 1.0 - 0.01 * float(np.mean(np.square(errors_in_jnd))))


def parametric_scores(mref, mvar):
    jnd = {}
    # layout: every box edge of every element, final frame, in 1080p pixels
    edges = []
    for name in ("head", "sub", "logo", "disc"):
        a, b = mref["layout"][name], mvar["layout"][name]
        edges += [abs(x - y) * TO_1080 / UNITS["position_px1080"] for x, y in zip(a, b)]
    jnd["layout"] = edges
    # motion: trajectories over time (headline centre y, headline coverage, disc radius and centre)
    cov_ref = np.asarray(mref["head_cov"])
    cov_var = np.asarray(mvar["head_cov"])
    cov_err = math.sqrt(np.mean((cov_ref / max(cov_ref[-1], 1e-9) - cov_var / max(cov_var[-1], 1e-9)) ** 2))
    jnd["motion"] = [series_rms(mref["head_cy"], mvar["head_cy"]) * TO_1080,
                     series_rms(mref["disc_r"], mvar["disc_r"]) * TO_1080,
                     series_rms(mref["disc_cx"], mvar["disc_cx"]) * TO_1080,
                     cov_err / UNITS["ratio"]]
    # colour roles, CIEDE2000
    jnd["color"] = [ciede2000(mref["lab"][k], mvar["lab"][k]) / UNITS["delta_e00"] for k in mref["lab"]]
    # typography metrics of the headline, relative
    jnd["typography"] = [abs(mvar["cap_height"] / mref["cap_height"] - 1) / UNITS["ratio"],
                         abs(mvar["stroke"] / mref["stroke"] - 1) / UNITS["ratio"],
                         abs(mvar["ink_density"] / mref["ink_density"] - 1) / (5 * UNITS["ratio"])]
    # effects: glow width, relative
    jnd["effects"] = [abs(mvar["glow"] / mref["glow"] - 1) / UNITS["glow_ratio"]]
    scores = {k: score(v) for k, v in jnd.items()}
    scores["composite_min"] = min(scores.values())
    return scores, {k: [round(x, 3) for x in v] for k, v in jnd.items()}


def main():
    font_head = ImageFont.truetype(FONT_BOLD, BASE["head_size"] * SS)
    font_sub = ImageFont.truetype(FONT_REG, 26 * SS)
    no_desc = lambda s: not any(c in s for c in "JQ")
    head, t_head, got_h, want_h = fit_words(BRAND_HEAD, NEUTRAL, font_head, count=2,
                                            needs=no_desc)
    head = head + " 4"  # keeps a digit like the reference; refit tracking on the full string
    w_new, _ = ink_width(head, font_head)
    w_ref, _ = ink_width(BRAND_HEAD, font_head)
    t_head = (w_ref - w_new) / (len(head) - 1) / SS
    has = lambda s: any(c in s for c in "gjpqy") and any(c in s for c in "bdfhklt")
    sub, t_sub, _, _ = fit_words(BRAND_SUB, NEUTRAL_SUB, font_sub, count=3, needs=has)
    t_sub = t_sub / SS
    swap = dict(BASE, head=head, sub=sub, logo="bars", tracking_head=t_head, tracking_sub=t_sub)
    variants = {
        "SWAP (content replaced, same geometry)": swap,
        "SWAP + headline 2 frames late": dict(swap, head_delay=2 / FPS),
        "SWAP + headline power2.out instead of power3.out": dict(swap, head_ease="power2.out"),
        "SWAP + accent colour shifted": dict(swap, accent=(214, 126, 74)),
        "SWAP + headline size +4 %": dict(swap, head_size=67),
        "SWAP + headline 8 px right (720p)": dict(swap, head_x=128.0),
        "SWAP + glow sigma +33 %": dict(swap, glow_sigma=24.0),
    }
    ref = render(BASE)
    mref = measure(ref)
    report = {"replacement": {"headline": head, "headline_tracking_px": round(t_head, 3),
                              "headline_tracking_em": round(t_head / BASE["head_size"], 5),
                              "subtitle": sub, "subtitle_tracking_px": round(t_sub, 3)},
              "units": UNITS, "rows": {}}
    controls = {"REF re-encoded (x264 CRF 23)": encode_decode(ref)}
    for label, frames in controls.items():
        mvar = measure(frames)
        report["rows"][label] = {"image": image_scores(ref, frames, mref, mvar), "parametric": parametric_scores(mref, mvar)[0],
                                 "jnd": parametric_scores(mref, mvar)[1]}
    for label, p in variants.items():
        frames = render(p)
        mvar = measure(frames)
        scores, jnd = parametric_scores(mref, mvar)
        report["rows"][label] = {"image": image_scores(ref, frames, mref, mvar), "parametric": scores, "jnd": jnd}
    accent_de = ciede2000(srgb_to_lab(ACCENT), srgb_to_lab((214, 126, 74)))
    report["accent_shift_delta_e00_nominal"] = accent_de
    json.dump(report, open(OUT, "w"), indent=1, default=float)
    print(json.dumps(report["replacement"]), "accent dE00", round(accent_de, 2))
    for label, row in report["rows"].items():
        im, pa = row["image"], row["parametric"]
        print(f"{label[:52]:52s} ssim {im['ssim_full']:.4f} corr {im['pixel_corr']:.4f} masked {im['ssim_masked']:.4f} "
              f"low16 {im['ssim_lowpass_sigma16']:.4f} | " + " ".join(f"{k[:5]} {v:.3f}" for k, v in pa.items()))


