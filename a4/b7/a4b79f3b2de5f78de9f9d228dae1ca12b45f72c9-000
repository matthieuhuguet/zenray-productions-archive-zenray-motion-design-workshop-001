~/.venvs/zenray-motion/bin/python -I Scripts/VerifyVector.py                  # vert attendu, code 0
~/.venvs/zenray-motion/bin/python -I Scripts/VerifyVector.py --no-sweep --sabotage   # rouge attendu, code 1
