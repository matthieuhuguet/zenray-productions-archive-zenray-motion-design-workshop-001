// 12 October 2026: Interleaved gradient noise dithering (Jimenez 2014 formula) of a two-colour ramp quantised to N levels. Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float dither_ign_ramp_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec4 dither_ign_ramp(vec2 uv, float angle, vec3 c0, vec3 c1, float levels, float cells, float aspect) {
  float t = dither_ign_ramp_axis(uv, angle);
  vec2 cell = floor(vec2(uv.x * aspect, uv.y) * cells + 0.000731);
  float th = fract(52.9829189 * fract(0.06711056 * cell.x + 0.00583715 * cell.y));
  float L = max(floor(levels), 2.0);
  float qv = clamp(floor(t * (L - 1.0) + th) / (L - 1.0), 0.0, 1.0);
  return vec4(mix(c0, c1, qv), 1.0);
}
