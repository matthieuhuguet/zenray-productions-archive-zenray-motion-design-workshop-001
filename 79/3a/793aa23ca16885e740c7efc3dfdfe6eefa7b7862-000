block("tonemap_neutral", "tonemap", "Khronos PBR Neutral tone mapping as in three.js r185 (MIT) applied to an HDR ramp, then sRGB encoding. Colour block.",
      HDR_PARAMS, ["axis", "srgb"], HDR_GL,
      HDR_PY + """    c = hdr * e
    start, desat = 0.8 - 0.04, 0.15
    x = c.min(axis=-1, keepdims=True)
    off = np.where(x < 0.08, x - 6.25 * x * x, 0.04)
    c = c - off
    peak = c.max(axis=-1, keepdims=True)
    d = 1.0 - start
    newp = 1.0 - d * d / (peak + d - start)
    g = 1.0 - 1.0 / (desat * (peak - newp) + 1.0)
    cc = c * (newp / np.maximum(peak, 1e-12))
    mapped = cc + (newp - cc) * g
    c = np.where(peak < start, c, mapped)
    return _to_srgb(c) * 255.0""",
      ["tonemap", "neutral", "khronos", "hdr", "colour"], ["product-render", "neutral-highlights"], LIC_THREE, URL_THREE, HDR_LIMIT)

