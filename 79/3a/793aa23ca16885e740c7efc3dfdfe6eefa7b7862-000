  for (int k = 0; k < 5; k++) {
    vec2 g = cen + (cen - s) * F[k] * spread;
    float r = size * G[k];
    float d = length(p - g);
    float disc = (1.0 - smoothstep(r - soft, r, d)) * (0.4 + 0.6 * min(d / r, 1.0));
    col += mix(color, color.gbr, float(k) / 4.0) * disc;
  }
  return vec4(clamp(intensity * col, 0.0, 1.0), 1.0);""",
      """F = (-0.45, -0.2, 0.3, 0.7, 1.4)
    G = (1.6, 0.6, 1.0, 0.4, 2.2)
    asp = q['aspect']
    px, py = u * asp, v
    cx, cy = 0.5 * asp, 0.5
    sx, sy = q['source'][0] * asp, q['source'][1]
    col = np.zeros(u.shape + (3,))
    c = _v(q['color'])
    for k in range(5):
        gx = cx + (cx - sx) * F[k] * q['spread']
        gy = cy + (cy - sy) * F[k] * q['spread']
        r = q['size'] * G[k]
        d = np.hypot(px - gx, py - gy)
        disc = (1.0 - _ss(r - q['soft'], r, d)) * (0.4 + 0.6 * np.minimum(d / r, 1.0))
        tint = c + (c[[1, 2, 0]] - c) * (k / 4.0)
        col += tint * disc[..., None]
    return np.clip(q['intensity'] * col, 0.0, 1.0) * 255.0""",
      ["flare", "ghosts", "lens", "light", "colour"], ["lens-flare", "sun-flare"],
      limit="soft must stay below size * 0.4 (smallest ghost) for the smoothstep edges to stay ordered.")

block("flare_halo", "flare", "Lens halo: a gaussian ring around the optical centre with per-channel radius dispersion (rainbow edge). Colour block.",
