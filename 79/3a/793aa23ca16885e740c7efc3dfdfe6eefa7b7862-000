block("colorkeys_oklab", "colour-time", "Flat colour animated through four keyframes (times 0, k1, k2, 1) interpolated in OKLab, eased per segment. Colour block.",
      [P("time", "float", 0.5, 0.0, 1.0, "normalised clip time"), C("c0", [0.10, 0.10, 0.35]), C("c1", [0.80, 0.25, 0.45]),
       C("c2", [0.95, 0.60, 0.25]), C("c3", [0.98, 0.95, 0.80]), P("k1", "float", 0.33, 0.0, 1.0, "key time"),
       P("k2", "float", 0.66, 0.0, 1.0, "key time"), P("ease", "float", 1.0, 0.0, 1.0, "0 = linear, 1 = smoothstep")], ["srgb", "oklab"],
      """float t = clamp(time, 0.0, 1.0);
  float p1 = min(k1, k2), p2 = max(k1, k2);
  vec3 a; vec3 b; float w;
  if (t < p1) { a = c0; b = c1; w = t / max(p1, 1e-6); }
  else if (t < p2) { a = c1; b = c2; w = (t - p1) / max(p2 - p1, 1e-6); }
  else { a = c2; b = c3; w = (t - p2) / max(1.0 - p2, 1e-6); }
  w = clamp(w, 0.0, 1.0);
  w = mix(w, w * w * (3.0 - 2.0 * w), ease);
  return vec4(@okmix(a, b, w), 1.0);""",
      """t = min(max(q['time'], 0.0), 1.0)
    p1, p2 = min(q['k1'], q['k2']), max(q['k1'], q['k2'])
    if t < p1:
        a, b, w = q['c0'], q['c1'], t / max(p1, 1e-6)
    elif t < p2:
        a, b, w = q['c1'], q['c2'], (t - p1) / max(p2 - p1, 1e-6)
    else:
        a, b, w = q['c2'], q['c3'], (t - p2) / max(1.0 - p2, 1e-6)
    w = min(max(w, 0.0), 1.0)
    w = w + (w * w * (3.0 - 2.0 * w) - w) * q['ease']
    col = _okmix(a, b, w)
    return np.broadcast_to(col, u.shape + (3,)) * 255.0""",
      ["colour", "keyframes", "oklab", "animated", "time", "transition"], ["colour-transition", "background-pulse", "mood-shift"], LIC_OKLAB)

