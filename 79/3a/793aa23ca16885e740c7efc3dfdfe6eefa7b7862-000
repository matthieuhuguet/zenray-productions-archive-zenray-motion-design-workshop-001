# 12 October 2026: grading operators exposed as <id>_apply helpers (written here so they live inside block.glsl).
APPLY_GL = {
    "grade_lift_gamma_gain": """// 12 October 2026: the grading operator, reusable on any sRGB colour.
vec3 @apply(vec3 x, vec3 lift, vec3 gamma, vec3 gain) {
  vec3 y = gain * (x + lift * (1.0 - x));
  return clamp(pow(max(y, vec3(1e-8)), 1.0 / gamma), 0.0, 1.0);
}""",
    "grade_exposure_saturation": """// 12 October 2026: the grading operator, reusable on any sRGB colour.
vec3 @apply(vec3 x, float exposure, float contrast, float pivot, float saturation) {
  vec3 s = @to_srgb(@to_lin(x) * exp2(exposure));
  s = (s - pivot) * contrast + pivot;
  float L = dot(s, vec3(0.2126, 0.7152, 0.0722));
  return clamp(mix(vec3(L), s, saturation), 0.0, 1.0);
}""",
    "tonemap_aces_filmic": """// 12 October 2026: ACES filmic from three.js r185 (MIT), tonemapping_pars_fragment; returns linear sRGB in 0..1.
vec3 @rrt_odt(vec3 v) {
  vec3 a = v * (v + 0.0245786) - 0.000090537;
  vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
  return a / b;
}
vec3 @apply(vec3 color, float exposure) {
  const mat3 ACESInputMat = mat3(vec3(0.59719, 0.07600, 0.02840), vec3(0.35458, 0.90834, 0.13383), vec3(0.04823, 0.01566, 0.83777));
  const mat3 ACESOutputMat = mat3(vec3(1.60475, -0.10208, -0.00327), vec3(-0.53108, 1.10813, -0.07276), vec3(-0.07367, -0.00605, 1.07602));
  color *= exposure / 0.6;
  color = ACESInputMat * color;
  color = @rrt_odt(color);
  color = ACESOutputMat * color;
  return clamp(color, 0.0, 1.0);
}""",
    "tonemap_agx": """// 12 October 2026: AgX from three.js r185 (MIT), tonemapping_pars_fragment; returns linear sRGB in 0..1.
vec3 @contrast_approx(vec3 x) {
  vec3 x2 = x * x;
  vec3 x4 = x2 * x2;
  return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}
vec3 @apply(vec3 color, float exposure) {
  const mat3 LINEAR_REC2020_TO_LINEAR_SRGB = mat3(vec3(1.6605, -0.1246, -0.0182), vec3(-0.5876, 1.1329, -0.1006), vec3(-0.0728, -0.0083, 1.1187));
  const mat3 LINEAR_SRGB_TO_LINEAR_REC2020 = mat3(vec3(0.6274, 0.0691, 0.0164), vec3(0.3293, 0.9195, 0.0880), vec3(0.0433, 0.0113, 0.8956));
  const mat3 AgXInsetMatrix = mat3(vec3(0.856627153315983, 0.137318972929847, 0.11189821299995),
    vec3(0.0951212405381588, 0.761241990602591, 0.0767994186031903), vec3(0.0482516061458583, 0.101439036467562, 0.811302368396859));
  const mat3 AgXOutsetMatrix = mat3(vec3(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
    vec3(-0.11060664309660323, 1.157823702216272, -0.11060664309660294), vec3(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
  const float AgxMinEv = -12.47393;
  const float AgxMaxEv = 4.026069;
  color *= exposure;
  color = LINEAR_SRGB_TO_LINEAR_REC2020 * color;
  color = AgXInsetMatrix * color;
  color = max(color, 1e-10);
  color = log2(color);
  color = (color - AgxMinEv) / (AgxMaxEv - AgxMinEv);
  color = clamp(color, 0.0, 1.0);
  color = @contrast_approx(color);
  color = AgXOutsetMatrix * color;
  color = pow(max(vec3(0.0), color), vec3(2.2));
  color = LINEAR_REC2020_TO_LINEAR_SRGB * color;
  return clamp(color, 0.0, 1.0);
}""",
    "tonemap_neutral": """// 12 October 2026: Khronos PBR Neutral from three.js r185 (MIT), tonemapping_pars_fragment; returns linear sRGB.
vec3 @apply(vec3 color, float exposure) {
  const float StartCompression = 0.8 - 0.04;
  const float Desaturation = 0.15;
  color *= exposure;
  float x = min(color.r, min(color.g, color.b));
  float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
  color -= offset;
  float peak = max(color.r, max(color.g, color.b));
  if (peak < StartCompression) return color;
  float d = 1. - StartCompression;
  float newPeak = 1. - d * d / (peak + d - StartCompression);
  color *= newPeak / peak;
  float g = 1. - 1. / (Desaturation * (peak - newPeak) + 1.);
  return mix(color, vec3(newPeak), g);
}""",
}

GLSL_TYPE = {"float": "float", "vec2": "vec2", "vec3": "vec3", "color": "vec3"}


def _deps(names: list[str], deps: dict) -> list[str]:
    out: list[str] = []
    for n in names:
        for d in deps.get(n, []) + [n]:
            for dd in deps.get(d, []) + [d]:
                if dd not in out:
                    out.append(dd)
    return out


def glsl_source(b: dict) -> str:
    bid = b["id"]
    helpers = _deps(b["helpers"], GL_DEPS)
    parts = [f"// {DATE}: {b['description']}", f"// {MARK}. Licence: {b['licence']}."]
    if b["source_url"]:
        parts.append(f"// Source: {b['source_url']}")
    parts.append("// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.")
    for h in helpers:
        parts.append(GLSL_HELPERS[h].replace("@", f"{bid}_"))
    if bid in APPLY_GL:
        parts.append(APPLY_GL[bid].replace("@", f"{bid}_"))
    sig = ", ".join(f"{GLSL_TYPE[p['type']]} {p['name']}" for p in b["params"])
    body = b["glsl"].replace("@", f"{bid}_").replace("CELL_EPS", CELL_EPS)
    parts.append(f"vec4 {bid}(vec2 uv, {sig}) {{\n  {body}\n}}")
    return "\n".join(parts) + "\n"


def twin_source(b: dict) -> str:
    helpers = ["base"] + _deps(b["helpers"], PY_DEPS)
    text = [f"# {DATE}: numpy twin of block.glsl for {b['id']} (same formula, vectorised); {MARK}.\n"]
    text += [PY_HELPERS[h] for h in helpers if h in PY_HELPERS]
    text.append(f"\n\ndef render(params, u, v):\n    q = params\n    {b['twin'].replace('CELL_EPS', CELL_EPS)}\n")
    return "".join(text)


def block_json(b: dict) -> dict:
    desc = f"{b['description']} ({DATE})"
    if b["limit"]:
        desc += f" Limit: {b['limit']}"
    return {"id": b["id"], "family": b["family"], "description": desc, "params": b["params"],
            "source_url": b["source_url"], "licence": b["licence"],
            "attribution": f"ZenRay Motion Design, {DATE}, {MARK}", "tags": b["tags"], "looks": b["looks"]}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", default="")
    a = ap.parse_args()
    only = {s for s in a.only.split(",") if s}
    root = bank.root()
    written, refused = [], []
    for b in BLOCKS:
        if only and b["id"] not in only:
            continue
        d = root / b["id"]
        glsl = d / "block.glsl"
        if glsl.exists() and MARK not in glsl.read_text(encoding="utf-8"):
            refused.append(b["id"])  # 12 October 2026: never overwrite a block another generator or person wrote.
            continue
        d.mkdir(parents=True, exist_ok=True)
        (d / "block.glsl").write_text(glsl_source(b), encoding="utf-8")
        (d / "twin.py").write_text(twin_source(b), encoding="utf-8")
        (d / "block.json").write_text(json.dumps(block_json(b), indent=2) + "\n", encoding="utf-8")
        written.append(b["id"])
    # 12 October 2026: index rebuilt from the folders under the shared bank lock, so a concurrent writer is never lost.
    with open(root / ".index.lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        bank.rebuild_index()
        fcntl.flock(lk, fcntl.LOCK_UN)
    print(json.dumps({"written": len(written), "refused": refused, "total_defined": len(BLOCKS),
                      "ids": [b["id"] for b in BLOCKS]}, indent=1))
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main())
