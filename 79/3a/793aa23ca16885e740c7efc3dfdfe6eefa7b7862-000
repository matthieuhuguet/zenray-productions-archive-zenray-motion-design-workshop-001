block("blur_rect_gaussian", "blur", "Exact anisotropic gaussian blur of an axis-aligned rectangle: product of erf differences per axis (sigma.x, sigma.y). Mask block.",
      [P("center", "vec2", [0.5, 0.5], [0.2, 0.2], [0.8, 0.8], "uv"), P("half_size", "vec2", [0.2, 0.12], [0.02, 0.02], [0.4, 0.3], "canvas heights"),
       P("sigma", "vec2", [0.02, 0.02], [0.001, 0.001], [0.1, 0.1], "gaussian sigma per axis, canvas heights"), ASPECT], ["erf"],
      """vec2 p = (uv - center) * vec2(aspect, 1.0);
  vec2 k = 1.0 / (sigma * 1.41421356);
  float mx = 0.5 * (@erf((p.x + half_size.x) * k.x) - @erf((p.x - half_size.x) * k.x));
  float my = 0.5 * (@erf((p.y + half_size.y) * k.y) - @erf((p.y - half_size.y) * k.y));
  return vec4(1.0, 1.0, 1.0, mx * my);""",
      """px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    kx, ky = 1.0 / (q['sigma'][0] * 1.41421356), 1.0 / (q['sigma'][1] * 1.41421356)
    bx, by = q['half_size']
    mx = 0.5 * (_erf((px + bx) * kx) - _erf((px - bx) * kx))
    my = 0.5 * (_erf((py + by) * ky) - _erf((py - by) * ky))
    return mx * my""",
      ["blur", "gaussian", "erf", "exact", "mask"], ["soft-card", "out-of-focus-ui", "shadow"],
      limit="Exact for an axis-aligned rectangle (separable). Rotated shapes need blur_motion_bar or blur_disc_gaussian.")

