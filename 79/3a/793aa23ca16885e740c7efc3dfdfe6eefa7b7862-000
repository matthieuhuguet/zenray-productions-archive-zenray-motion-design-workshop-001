       P("threshold", "float", 1.0, 0.0, 2.0, "bloom threshold"), P("core_radius", "float", 0.05, 0.01, 0.15, "cell units"),
       P("glow_sigma", "float", 0.12, 0.02, 0.3, "cell units"), P("intensity", "float", 1.0, 0.0, 3.0, "bloom gain"),
