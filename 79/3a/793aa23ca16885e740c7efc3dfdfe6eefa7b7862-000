       P("width", "float", 0.03, 0.005, 0.1, "gaussian half width"), P("dispersion", "float", 0.01, 0.0, 0.05, "relative radius step per channel"),
       C("color", [1.0, 0.9, 0.8]), P("intensity", "float", 0.5, 0.0, 2.0, "gain"), ASPECT], [],
