block("flare_streak", "flare", "Anamorphic lens flare streak: exponential cross profile times gaussian length, plus a gaussian core, rotatable. Colour block.",
      [P("center", "vec2", [0.5, 0.5], [0.1, 0.1], [0.9, 0.9], "uv"), P("angle", "float", 0.0, -90.0, 90.0, "degrees"),
       P("streak_len", "float", 0.4, 0.05, 1.0, "gaussian sigma along the streak"), P("thickness", "float", 0.006, 0.001, 0.05, "exponential scale across"),
       P("core", "float", 0.03, 0.005, 0.1, "core gaussian radius"), C("color", [0.4, 0.6, 1.0]), C("core_color", [1.0, 1.0, 1.0]),
