CA_HEAD_GL = """vec3 col;
  for (int k = 0; k < 3; k++) {
    float sc = 1.0 + (1.0 - float(k)) * strength;
    vec2 q = optic + (uv - optic) * sc;
    vec2 p = (q - center) * vec2(aspect, 1.0);
    %s
    col[k] = 1.0 - smoothstep(-soft, soft, d);
  }
  return vec4(color * col, 1.0);"""
CA_HEAD_PY = """chans = []
    for k in range(3):
        sc = 1.0 + (1.0 - k) * q['strength']
        qu = q['optic'][0] + (u - q['optic'][0]) * sc
        qv = q['optic'][1] + (v - q['optic'][1]) * sc
        px = (qu - q['center'][0]) * q['aspect']
        py = qv - q['center'][1]
        %s
        chans.append(1.0 - _ss(-q['soft'], q['soft'], d))
    return _v(q['color']) * np.stack(chans, axis=-1) * 255.0"""
