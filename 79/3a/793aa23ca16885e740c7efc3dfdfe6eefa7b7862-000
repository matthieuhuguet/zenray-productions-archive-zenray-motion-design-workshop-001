  vec2 l = vec2(cos(a) * p.x + sin(a) * p.y, -sin(a) * p.x + cos(a) * p.y);
  float sx = l.x / streak_len;
  float streak = exp(-abs(l.y) / thickness) * exp(-sx * sx);
  float r = dot(p, p) / (core * core);
  return vec4(clamp(intensity * (color * streak + core_color * exp(-r)), 0.0, 1.0), 1.0);""",
