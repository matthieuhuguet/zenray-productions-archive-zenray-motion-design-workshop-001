import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def render(params, u, v):
    q = params
    t = _axis(u, v, q['angle'])
    cx = np.floor(u * q['aspect'] * q['cells'] + 0.000731)
    cy = np.floor(v * q['cells'] + 0.000731)
    x = (cx.astype(np.int64) & 7)
    y = (cy.astype(np.int64) & 7)
    z = x ^ y
    idx = 16 * (2 * (z & 1) + (y & 1)) + 4 * (2 * ((z >> 1) & 1) + ((y >> 1) & 1)) + (2 * ((z >> 2) & 1) + ((y >> 2) & 1))
    th = (idx + 0.5) / 64.0
    L = max(np.floor(q['levels']), 2.0)
    qv = np.clip(np.floor(t * (L - 1.0) + th) / (L - 1.0), 0.0, 1.0)[..., None]
    return (_v(q['c0']) + (_v(q['c1']) - _v(q['c0'])) * qv) * 255.0
