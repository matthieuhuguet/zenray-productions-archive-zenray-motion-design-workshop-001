def parse_params(s):
    out = []
    for p in [x.strip() for x in s.split(";") if x.strip()]:
        name, rest = p.split("=",1)
        rng, rest2 = rest.split("~",1)
        typ, unit = rest2.rsplit(" ",1) if " " in rest2 else (rest2, "")
        if ".." not in rng:
            out.append({"name":name,"values":rng.split("|"),"typical":typ,"unit":unit}); continue
        lo, hi = rng.split("..")
        def num(v):
            try: return float(v)
            except ValueError: return v
        if "|" in lo or "|" in hi:
            out.append({"name":name,"values":(lo+"|"+hi).split("|"),"typical":typ,"unit":unit})
        else:
            out.append({"name":name,"min":num(lo),"max":num(hi),"typical":num(typ),"unit":unit})
    return out

