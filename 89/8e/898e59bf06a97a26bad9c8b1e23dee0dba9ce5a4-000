html, body { margin: 0; padding: 0; background: #000; }
#root { position: relative; width: 1920px; height: 1080px; overflow: hidden; isolation: isolate; }
#bg { position: absolute; z-index: 0; inset: 0; background: #000000; filter: blur(calc(var(--zr-blur, 0) * 1px)) brightness(var(--zr-bright, 1)); will-change: transform, opacity; }
#orb { position: absolute; z-index: 1; left: 0; top: 0; width: 100%; height: 100%; filter: blur(calc(var(--zr-blur, 0) * 1px)) brightness(var(--zr-bright, 1)); will-change: transform, opacity; }
