:root[data-theme="dark"] { --bg: #161615; --card: #20201e; --ink: #ecebe7; --muted: #a3a29c; --line: #34332f; --chip: #2b2a27; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); }
body { font-family: var(--zr-police-sans); font-weight: var(--zr-poids-sans); font-size: var(--size-ui); line-height: 1.45;
